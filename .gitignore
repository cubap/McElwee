# RERUM credentials for the local proxy. Copy sample.env to .env; never commit the real one.
.env

dist/

# Impeccable design-detector scratch cache; PRODUCT.md and DESIGN.md are committed, this is not.
.impeccable/hook.cache.json

# Regenerable with: node source/burials-index/derive-fields.mjs
source/burials-index/burials-derived.json
source/burials-index/burials-derived.csv

# Regenerable with: node scripts/load-burials.js   (the dry-run plan; the ledger beside it is the real record)
source/burials-evidence/burials-plan.json

# Regenerable with: node scripts/catalog-provenance.js   (the dry-run plan)
source/handoff/catalog/provenance-plan.json

# Regenerable with: npm run build   (scripts/build-burials.js -> the public burial index)
web/data/burials.json

# Regenerable with: npm run build   (scripts/build-atlas.js -> the published atlas plate index)
web/data/atlas.json

# Working download folder; the published plates live flat in web/manifest/fotki/
web/manifest/fotki/burials/
