{
  "name": "mcelwee",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Read-only exhibit of the McElwee Cemetery catalog, with a local-only TinyNode proxy for RERUM writes.",
  "license": "CC-BY",
  "author": "Walter J. Ong, S.J. Center for Digital Humanities <digitalhumanities@slu.edu>",
  "engines": {
    "node": ">=22",
    "npm": ">=8"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "build": "node scripts/build.js",
    "preview": "node scripts/build.js && node scripts/preview.js",
    "proof": "node scripts/proof.js",
    "check:handoff": "node scripts/check-handoff.js",
    "handoff:rows": "node source/handoff/burials/make-rows.mjs",
    "handoff:sheets": "powershell -NoProfile -ExecutionPolicy Bypass -File source/handoff/burials/tool/sheets.ps1",
    "handoff:ocr": "powershell -NoProfile -ExecutionPolicy Bypass -File source/handoff/burials/tool/ocr-sheets.ps1",
    "handoff:lines": "node source/handoff/burials/make-lines.mjs",
    "handoff:baseline": "node source/handoff/burials/make-baseline.mjs",
    "handoff:review": "node source/handoff/burials/make-review.mjs && powershell -NoProfile -ExecutionPolicy Bypass -File source/handoff/burials/tool/zip.ps1 -Mode review",
    "handoff:zip": "powershell -NoProfile -ExecutionPolicy Bypass -File source/handoff/burials/tool/zip.ps1",
    "whoami": "node scripts/whoami.js",
    "burials:plan": "node scripts/load-burials.js",
    "burials:load": "node scripts/load-burials.js --execute",
    "findagrave:match": "node source/findagrave/match.mjs",
    "findagrave:merge": "node source/findagrave/merge.mjs",
    "catalog:provenance": "node scripts/catalog-provenance.js",
    "catalog:provenance:load": "node scripts/catalog-provenance.js --execute",
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
