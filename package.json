{
  "name": "mcelwee",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Read-only exhibit of the McElwee Cemetery catalog, with a local-only TinyNode proxy for RERUM writes.",
  "license": "CC-BY",
  "author": "Walter J. Ong, S.J. Center for Digital Humanities <digitalhumanities@slu.edu>",
  "engines": {
    "node": ">=22",
    "npm": ">=8"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "build": "node scripts/build.js",
    "preview": "node scripts/build.js && node scripts/preview.js",
    "whoami": "node scripts/whoami.js",
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
