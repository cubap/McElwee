# Copy this file to `.env` in the repo root. `.env` is gitignored; never commit a real token.
#
# What you put here decides who RERUM thinks wrote your data. Every record RERUM stores
# carries `__rerum.generatedBy`, and the store fills that in from the agent your
# ACCESS_TOKEN belongs to. The 2018 records in this exhibit were written by the shared
# TinyThings sandbox agent, so they are all attributed to `sandbox@rerum.io`. Register
# your own agent (see "Registering with RERUM" in the README), put its tokens here, and
# set EXPECTED_AGENT_IRI so this app refuses to write under anyone else's name.

# --- RERUM credentials (from registration) ---
ACCESS_TOKEN=
REFRESH_TOKEN=

# The agent IRI your tokens belong to. `npm run whoami` decodes ACCESS_TOKEN and tells
# you what you actually have. Leave blank to only warn; set REQUIRE_AGENT_IRI=true to
# make a mismatch a hard failure.
EXPECTED_AGENT_IRI=
REQUIRE_AGENT_IRI=false

# --- RERUM instance ---
# The McElwee records live on the production store (issue #14 migration complete).
RERUM_REGISTRATION_URL=https://store.rerum.io/v1/
RERUM_API_ADDR=https://store.rerum.io/v1/api/
RERUM_ID_PATTERN=https://store.rerum.io/v1/id/
RERUM_ACCESS_TOKEN_URL=https://store.rerum.io/client/request-new-access-token

# --- Local server ---
PORT=3030
ORIGIN=http://localhost:3030
RERUM_FETCH_TIMEOUT_MS=30000

# Set true only if you intend to run this as a shared open API for other front ends.
# Leave false for a private, project-local proxy.
OPEN_API_CORS=false
